# DFSha - variables de entorno. Copia este archivo a .env y completa los secretos.
#   cp .env.example .env
# .env esta en .gitignore: nunca lo subas al repositorio.

# --- Comun ---------------------------------------------------------------
# Tamano de bloque en bytes. Default 64 MB. Para las pruebas de integracion
# se baja a 1048576 (1 MB).
DFSHA_BLOCK_SIZE=67108864
# Nivel de log: DEBUG | INFO | WARNING | ERROR
DFSHA_LOG_LEVEL=INFO

# --- Secretos (SIN default en el codigo: si faltan, el servicio no arranca) ---
# Genera valores propios, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DFSHA_JWT_SECRET=
DFSHA_INTERNAL_SECRET=

# --- ControlNode ---------------------------------------------------------
DFSHA_DB_URL=sqlite:///./dfsha.db
DFSHA_JWT_TTL_SECONDS=3600
# Vencimiento de las reservas de escritura (archivos en estado WRITING)
DFSHA_WRITE_TTL_SECONDS=600

# --- DataNode ------------------------------------------------------------
DFSHA_DATA_DIR=/var/lib/dfsha
# Capacidad anunciada por el DataNode, en bytes. Vacio = se deduce del disco.
DFSHA_DATANODE_CAPACITY_BYTES=
# URL con la que el DataNode se anuncia al ControlNode. Tiene que ser la URL
# ALCANZABLE POR EL CLIENTE, no la que el ControlNode usaria internamente: los
# bytes viajan directos entre cliente y DataNode, asi que el ControlNode se limita
# a repetirle al cliente esta cadena tal cual.
#
# Escenario soportado en la Etapa 1: el cliente corre en el HOST y docker compose
# publica el puerto 8001. Por eso el valor por defecto es localhost.
#   cliente en el host        -> http://localhost:8001   (el del quickstart)
#   cliente en un contenedor  -> http://data-node-1:8001 (nombre de servicio de
#                                compose; un cliente del host NO resuelve ese
#                                nombre y el put fallaria en el primer bloque)
# Los dos escenarios se excluyen: un unico DataNode solo puede anunciar una URL.
# En la Etapa 2, con N nodos, esto lo resuelve el ControlNode anunciando la
# direccion visible para cada cliente.
DFSHA_DATANODE_BASE_URL=http://localhost:8001

# --- Cliente y DataNode: donde vive el ControlNode -----------------------
DFSHA_CONTROL_URL=http://localhost:8000
