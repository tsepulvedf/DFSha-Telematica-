# DFSha - variables de entorno. Copia este archivo a .env y completa los secretos.
#   cp .env.example .env
# .env esta en .gitignore: nunca lo subas al repositorio.

# --- Comun ---------------------------------------------------------------
# Tamano de bloque en bytes. Default 64 MB. Para las pruebas de integracion
# se baja a 1048576 (1 MB).
DFSHA_BLOCK_SIZE=67108864
# Nivel de log: DEBUG | INFO | WARNING | ERROR
DFSHA_LOG_LEVEL=INFO

# --- Secretos (SIN default en el codigo: si faltan, el servicio no arranca) ---
# Genera valores propios, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DFSHA_JWT_SECRET=
DFSHA_INTERNAL_SECRET=

# --- ControlNode ---------------------------------------------------------
DFSHA_DB_URL=sqlite:///./dfsha.db
DFSHA_JWT_TTL_SECONDS=3600
# Vencimiento de las reservas de escritura (archivos en estado WRITING)
DFSHA_WRITE_TTL_SECONDS=600

# --- Plano de control (Etapa 2) ------------------------------------------
# gRPC, solo ControlNode <-> DataNode. El trafico de cliente sigue en REST.
DFSHA_GRPC_PORT=9000
DFSHA_HEARTBEAT_INTERVAL_MS=3000
DFSHA_FULL_REPORT_EVERY_N=20

# Deteccion de caidas. Son agresivos a proposito, para que la transicion quepa
# en la demostracion del hito; en produccion serian mucho mas largos.
#   SUSPECT: fuera de la colocacion, pero sus replicas se siguen sirviendo.
#   DEAD:    replicas marcadas no disponibles.
# SUSPECT tiene que ser menor que DEAD o el servicio no arranca.
DFSHA_SUSPECT_AFTER_MS=10000
DFSHA_DEAD_AFTER_MS=30000
# Cada cuanto corre el evaluador que persiste las transiciones y emite el evento.
DFSHA_MEMBERSHIP_INTERVAL_MS=1000

# --- Colocacion ----------------------------------------------------------
# R=1 en la Etapa 2. La politica soporta R>1 y esta probada para ello, pero la
# replicacion efectiva (pipeline, quorum W, re-replicacion) llega en la Etapa 3.
DFSHA_REPLICATION_FACTOR=1
# Power of d choices: se elige al azar entre los d menos cargados, en vez del
# mas vacio, para evitar que todas las escrituras concurrentes vayan al mismo
# nodo hasta el siguiente heartbeat.
DFSHA_PLACEMENT_D=3
# Margen de seguridad: un nodo necesita block_size + esto para ser candidato.
DFSHA_MIN_FREE_BYTES=134217728

# --- DataNode ------------------------------------------------------------
DFSHA_DATA_DIR=/var/lib/dfsha
# Capacidad anunciada por el DataNode, en bytes. Vacio = se deduce del disco.
DFSHA_DATANODE_CAPACITY_BYTES=
# Donde escucha el plano de control. Es gRPC, no REST, y es trafico
# ControlNode<->DataNode: aqui SI se usa el nombre de servicio interno.
DFSHA_CONTROL_GRPC_URL=control-node:9000

# URL con la que el DataNode se anuncia. Tiene que ser la ALCANZABLE POR EL
# CLIENTE, no la interna: el ControlNode se limita a repetirsela al cliente en
# el plan, porque los bytes van directos.
#
# DECISION: una sola direccion por nodo, fijada por la configuracion del
# despliegue. Soportar cliente en el host Y cliente en contenedor a la vez
# exigiria que cada nodo anunciara dos direcciones y que el ControlNode
# eligiera segun el origen de la peticion; ese coste no se paga. Ver CLAUDE.md.
#
#   compose local, cliente en el host -> http://localhost:8001 .. :8004
#   AWS, una instancia por DataNode   -> http://<IP PRIVADA>:8001
#
# En AWS se anuncia la IP PRIVADA, no la publica: las publicas cambian al
# reiniciar la instancia en AWS Academy y la privada es estable dentro de la
# VPC. Consecuencia: el cliente corre dentro del cluster o por tunel SSH.
DFSHA_DATANODE_ADVERTISE_URL=http://localhost:8001

# Identificador opaco del dominio de falla: el ControlNode solo compara
# igualdad, asi que el mismo codigo sirve para simular en local y para ser real
# en AWS. La politica de colocacion reparte las replicas entre dominios
# distintos, y avisa en el log si tiene que relajar la restriccion.
#
#   compose local -> local-1 .. local-4 (separacion logica)
#   AWS           -> us-east-1b / us-east-1d (separacion fisica)
DFSHA_DATANODE_FAULT_DOMAIN=local-1

# --- Cliente y DataNode: donde vive el ControlNode -----------------------
DFSHA_CONTROL_URL=http://localhost:8000
