.env
.env.local
*.pem
*.key
*.crt
*.csr
# La CA y los certificados de la Etapa 3. Se generan con scripts/gen_certs.py;
# lo que se versiona es el script y el procedimiento, nunca las claves.
certs/
deploy/certs/

# Metadato y datos de bloques (nunca versionar)
