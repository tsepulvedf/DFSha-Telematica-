*.db-journal
*.db-wal
*.db-shm
*.blk
*.meta
data/
var/
dfsha.db
.dfsha/

# Archivos de prueba generados (usa scripts/gen_testfile.py)
testfiles/
*.bin

# Codigo generado desde el .proto: se regenera en el build y en el CI.
# Versionarlo ata el repositorio a la version exacta de protobuf con la que se genero.
src/dfsha/common/proto/gen/

