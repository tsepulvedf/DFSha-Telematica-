# DFSha - DataNode en AWS. Copia a .env en cada instancia dfsha-data-N.
#
# Cada instancia corre UN solo DataNode: t3.micro es 1 GB de RAM, y meter dos en
# la misma maquina ademas anularia el sentido de los dominios de falla.
#
#   cp deploy/.env.datanode.example .env
#   nano .env
#   docker compose -f deploy/docker-compose.datanode.yml up --build -d

# --- CAMBIA EN CADA INSTANCIA --------------------------------------------

# 1) La URL con la que este nodo se anuncia. Tiene que ser la ALCANZABLE POR EL
#    CLIENTE: el ControlNode se limita a repetirsela en el plan, porque los
#    bytes van directos del cliente al DataNode.
#
#    IP PRIVADA, no publica: en AWS Academy las publicas cambian al reiniciar la
#    instancia, y una URL anunciada que deja de resolver convierte cada put en un
#    fallo de conexion sin explicacion aparente. La privada es estable en la VPC.
#    Consecuencia: el cliente corre dentro del cluster o por tunel SSH.
#
#    dfsha-data-1 -> http://<IP_PRIVADA_1>:8001
#    dfsha-data-2 -> http://<IP_PRIVADA_2>:8001
#    dfsha-data-3 -> http://<IP_PRIVADA_3>:8001
#    dfsha-data-4 -> http://<IP_PRIVADA_4>:8001
DFSHA_DATANODE_ADVERTISE_URL=http://<IP_PRIVADA_DE_ESTA_INSTANCIA>:8001

# 2) El dominio de falla: la zona de disponibilidad real de esta instancia. El
#    ControlNode solo compara igualdad, asi que aqui la separacion pasa a ser
#    fisica sin tocar una linea de codigo.
#
#    dfsha-data-1, dfsha-data-2 -> us-east-1b
#    dfsha-data-3, dfsha-data-4 -> us-east-1d
DFSHA_DATANODE_FAULT_DOMAIN=us-east-1b

# NOTA: DFSHA_DATANODE_PEER_URL se deja VACIA en AWS, y merece una linea.
#    Vacia significa "la misma que la de cliente", que es el despliegue donde el
#    cliente y los nodos comparten red. En AWS es el caso, porque la opcion
#    soportada es el cliente DENTRO de la VPC. En docker compose si hacen falta
#    las dos, porque alli el cliente esta fuera de la red de contenedores.
#    No es un caso degradado: es el caso simple.

# --- IGUAL EN LOS CUATRO -------------------------------------------------

# Donde escucha el plano de control: IP PRIVADA del ControlNode, puerto gRPC.
DFSHA_CONTROL_GRPC_URL=<IP_PRIVADA_CONTROL>:9000

# La misma IP, suelta. El compose la usa para componer la URL del plano interno.
DFSHA_CONTROL_PRIVATE_IP=<IP_PRIVADA_CONTROL>

# Confirmacion de bloque almacenado y endpoints del GC. Van por el PLANO INTERNO
# (8443, con mTLS) y no por el 8000: el certificado de cliente no se puede exigir
# en unas rutas y no en otras dentro del mismo puerto.
#
# Sigue en REST y no en gRPC a proposito: el DataNode la llama de forma sincrona
# antes de responder 201 al cliente, para que un commit inmediato no curse contra
# el periodo del heartbeat.
DFSHA_CONTROL_INTERNAL_URL=https://<IP_PRIVADA_CONTROL>:8443

# --- TLS mutuo: los tres son OBLIGATORIOS --------------------------------
# Los deja en /etc/dfsha/certs el paso 4 del README. El DataNode ademas comprueba
# que los ficheros EXISTEN al arrancar, para que el fallo sea "no existe
# certs/data.crt" y no un error de handshake diez segundos despues.
#
# El certificado tiene que llevar la IP PRIVADA de este nodo en su SAN, o el
# pipeline falla en el handshake. Se consigue con gen_certs.py --hosts.
DFSHA_TLS_CA_CERT=/etc/dfsha/certs/ca.crt
DFSHA_TLS_CERT=/etc/dfsha/certs/data.crt
DFSHA_TLS_KEY=/etc/dfsha/certs/data.key

DFSHA_DATA_DIR=/var/lib/dfsha
# Capacidad anunciada. Vacio = se deduce del disco de la instancia. Con el EBS
# de 8 GB por defecto conviene dejarlo vacio; si subes el disco, fijalo.
DFSHA_DATANODE_CAPACITY_BYTES=
DFSHA_LOG_LEVEL=INFO

# El ControlNode puede tardar en aceptar conexiones. 30 intentos cada 2 s.
DFSHA_REGISTER_MAX_ATTEMPTS=30
DFSHA_REGISTER_RETRY_SECONDS=2
