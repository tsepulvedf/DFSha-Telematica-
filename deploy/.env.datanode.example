# DFSha - DataNode en AWS. Copia a .env en cada instancia dfsha-data-N.
#
#   cp deploy/.env.datanode.example .env
#   nano .env
#   docker compose -f deploy/docker-compose.datanode.yml up --build -d
#
# TODO VALOR ESTA ESCRITO, incluso los que coinciden con otro. Un valor escrito se
# comprueba leyendo este fichero; uno vacio obliga a razonar que significa la ausencia, y
# ese razonamiento es el que fallo en el Bloque B.

# --- CAMBIA EN CADA INSTANCIA: tres lineas ----------------------------------

# 1) La URL con la que el CLIENTE llega a este nodo: el ControlNode se la repite en el
#    plan, porque los bytes van directos del cliente al DataNode.
#
#    https://, por el TLS de cliente (C2), encendido en AWS.
#    IP PRIVADA, no publica: en AWS Academy las publicas cambian al reiniciar, y una URL
#    anunciada que deja de resolver convierte cada put en un fallo sin explicacion. La
#    privada es estable, y es la que lleva el SAN del certificado (paso 4).
#
#    dfsha-data-1 -> https://<IP_PRIVADA_1>:8001     dfsha-data-3 -> https://<IP_PRIVADA_3>:8001
#    dfsha-data-2 -> https://<IP_PRIVADA_2>:8001     dfsha-data-4 -> https://<IP_PRIVADA_4>:8001
DFSHA_DATANODE_ADVERTISE_URL=https://<IP_PRIVADA_DE_ESTA_INSTANCIA>:8001

# 2) La URL con la que OTROS DATANODES llegan a este: pipeline y re-replicacion.
#    En AWS es la MISMA que la de arriba, porque el cliente corre dentro de la VPC
#    (opcion (a) del README). Se escribe igualmente: vacia significaria lo mismo, pero
#    habria que saberlo, y con C2 tiene que llevar https:// igual que la otra.
DFSHA_DATANODE_PEER_URL=https://<IP_PRIVADA_DE_ESTA_INSTANCIA>:8001

# 3) El dominio de falla: la zona de disponibilidad real de esta instancia.
#
#    dfsha-data-1, dfsha-data-2 -> us-east-1b
#    dfsha-data-3, dfsha-data-4 -> us-east-1d
DFSHA_DATANODE_FAULT_DOMAIN=us-east-1b

# --- IGUAL EN LOS CUATRO ----------------------------------------------------

# El plano de control, a traves de NGINX EN DFSHA-DB y no de un ControlNode concreto: asi
# matar a cualquiera de los dos no deja a este nodo sin camino. Reconecta y su latido acaba
# en el otro, porque el heartbeat escribe en la base compartida.
DFSHA_CONTROL_GRPC_URL=<IP_PRIVADA_DB>:9000

# Confirmacion de bloque almacenado, por el plano interno (mTLS), tambien por nginx. Es
# SINCRONA antes del 201 al cliente: si esta URL esta mal, ningun put confirma.
DFSHA_CONTROL_INTERNAL_URL=https://<IP_PRIVADA_DB>:8443

# --- TLS mutuo del plano interno: OBLIGATORIOS -----------------------------
# Los deja en /etc/dfsha/certs el paso 4. El certificado lleva la IP privada de este nodo
# en su SAN, o el pipeline falla en el handshake.
DFSHA_TLS_CA_CERT=/etc/dfsha/certs/ca.crt
DFSHA_TLS_CERT=/etc/dfsha/certs/data.crt
DFSHA_TLS_KEY=/etc/dfsha/certs/data.key

# --- TLS de cliente (C2): ENCENDIDO en AWS ---------------------------------
# El puerto 8001 habla HTTPS con el cliente y con los otros DataNodes, que verifican
# contra ca.crt. Mismo certificado que el plano interno.
DFSHA_CLIENT_TLS_CERT=/etc/dfsha/certs/data.crt
DFSHA_CLIENT_TLS_KEY=/etc/dfsha/certs/data.key

# --- Resto --------------------------------------------------------------------
# Capacidad anunciada. Vacia = se deduce del disco (es la unica vacia, y es legitima:
# desde la Etapa 3 una variable vacia cuenta como no puesta). Si subes el disco, fijala.
DFSHA_DATANODE_CAPACITY_BYTES=
DFSHA_LOG_LEVEL=INFO
# Hilos para ordenes del plano de control (copias de re-replicacion).
DFSHA_ORDER_WORKERS=2
# El ControlNode puede tardar en aceptar conexiones. 30 intentos cada 2 s.
DFSHA_REGISTER_MAX_ATTEMPTS=30
DFSHA_REGISTER_RETRY_SECONDS=2
