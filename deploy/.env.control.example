# DFSha - ControlNode en AWS. Copia a .env en la instancia dfsha-control.
#
# Esta instancia corre UN solo servicio: t3.micro es 1 GB de RAM.
#
#   cp deploy/.env.control.example .env
#   nano .env
#   docker compose -f deploy/docker-compose.control.yml up --build -d

# --- Secretos: RELLENA LOS DOS -------------------------------------------
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# DFSHA_INTERNAL_SECRET YA NO EXISTE. Lo sustituyo el TLS mutuo del Bloque C: un
# secreto compartido protege contra quien no lo conoce, pero no dice QUIEN esta
# al otro lado, y cualquiera que lo tenga es todos a la vez.
DFSHA_JWT_SECRET=

# El metadato vive en su propia instancia (dfsha-db). La contrasena es la que
# generaste para POSTGRES_PASSWORD.
DFSHA_DB_URL=postgresql+psycopg://dfsha:<DFSHA_PG_PASSWORD>@<IP_PRIVADA_DB>:5432/dfsha

# Replica de lectura: VACIA en AWS, porque seria una septima instancia. No es una
# degradacion sino un modo soportado: sin ella el lado de consulta de CQRS se
# sirve del primario y el sistema se comporta como en las etapas anteriores.
DFSHA_DB_REPLICA_URL=

# --- TLS mutuo del plano interno: los tres son OBLIGATORIOS ---------------
# Los ficheros los deja en /etc/dfsha/certs el paso 4 del README, y el compose
# los monta en solo lectura. Sin ellos el servicio NO ARRANCA, a proposito.
DFSHA_TLS_CA_CERT=/etc/dfsha/certs/ca.crt
DFSHA_TLS_CERT=/etc/dfsha/certs/control.crt
DFSHA_TLS_KEY=/etc/dfsha/certs/control.key
# Puerto propio, separado del de cliente: uvicorn no expone el certificado del
# cliente a la aplicacion, asi que no se puede exigir en unas rutas y no en otras
# dentro del mismo puerto.
DFSHA_INTERNAL_PORT=8443

# --- No cambian entre instancias -----------------------------------------
DFSHA_BLOCK_SIZE=67108864
DFSHA_JWT_TTL_SECONDS=3600
DFSHA_WRITE_TTL_SECONDS=600
DFSHA_LOG_LEVEL=INFO

# El servidor gRPC escucha aqui dentro del contenedor. El grupo de seguridad
# solo abre este puerto al propio grupo, nunca a Internet: el plano de control
# no tiene autenticacion mutua hasta la Etapa 3.
DFSHA_GRPC_PORT=9000
DFSHA_HEARTBEAT_INTERVAL_MS=3000
DFSHA_FULL_REPORT_EVERY_N=20

# Umbrales de deteccion. Agresivos a proposito para que la transicion se vea en
# la demostracion; en produccion serian mucho mas largos, porque declarar muerto
# a un nodo vivo es caro. SUSPECT tiene que ser menor que DEAD.
DFSHA_SUSPECT_AFTER_MS=10000
DFSHA_DEAD_AFTER_MS=30000
DFSHA_MEMBERSHIP_INTERVAL_MS=1000

# R=1 en esta etapa. La politica soporta R>1 y esta probada para ello, pero la
# replicacion efectiva llega en la Etapa 3.
DFSHA_REPLICATION_FACTOR=1
DFSHA_PLACEMENT_D=3
DFSHA_MIN_FREE_BYTES=134217728
