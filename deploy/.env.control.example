# DFSha - los dos ControlNodes en AWS. EL MISMO FICHERO en dfsha-control y en dfsha-db.
#
#   cp deploy/.env.control.example .env
#   nano .env
#
# Que sea el mismo no es comodidad: los dos ControlNodes TIENEN que compartir el secreto
# de JWT (un token emitido por uno lo valida el otro, porque nginx reparte entre ambos) y
# la URL de la base. Dos ficheros que "deberian ser iguales" acaban no siendolo; uno
# copiado se comprueba con `sha256sum .env` en las dos instancias.
#
# dfsha-db usa ademas POSTGRES_PASSWORD (el contenedor de PostgreSQL) y
# DFSHA_CONTROL_A_IP (las plantillas de nginx). En dfsha-control sobran y no molestan.
#
# TODO VALOR ESTA ESCRITO. Nada vacio que haya que interpretar, nada compuesto por el
# compose: lo que dice este fichero es lo que recibe el servicio.

# --- Secretos: RELLENA LOS DOS, iguales en las dos instancias --------------
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DFSHA_JWT_SECRET=
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# --- Direcciones ------------------------------------------------------------
# La base, por la IP PRIVADA de dfsha-db. Vale igual desde las dos instancias: el
# ControlNode de dfsha-db llega a su propia IP privada porque el 5432 esta publicado.
# La contrasena es la de POSTGRES_PASSWORD, repetida aqui.
DFSHA_DB_URL=postgresql+psycopg://dfsha:<POSTGRES_PASSWORD>@<IP_PRIVADA_DB>:5432/dfsha

# Replica de lectura: VACIA en AWS, y es un modo SOPORTADO, no una degradacion: el lado de
# consulta de CQRS se sirve del primario. Seria otra instancia de PostgreSQL.
DFSHA_DB_REPLICA_URL=

# IP privada de dfsha-control. Solo la usa nginx en dfsha-db, para repartir hacia el
# ControlNode de esa instancia.
DFSHA_CONTROL_A_IP=<IP_PRIVADA_CONTROL>

# --- TLS mutuo del plano interno: OBLIGATORIOS -----------------------------
# Los deja en /etc/dfsha/certs el paso 4 del README. Sin ellos el servicio NO ARRANCA.
DFSHA_TLS_CA_CERT=/etc/dfsha/certs/ca.crt
DFSHA_TLS_CERT=/etc/dfsha/certs/control.crt
DFSHA_TLS_KEY=/etc/dfsha/certs/control.key
DFSHA_INTERNAL_PORT=8443
DFSHA_GRPC_PORT=9000

# --- TLS de cliente (C2): ENCENDIDO en AWS ---------------------------------
# En el compose local viene apagado, porque el modo por defecto es el de quien clona y
# hace `docker compose up`. AWS es el despliegue real, y aqui el trafico cruza redes: el
# JWT, el metadato y los tokens de bloque viajan cifrados. Mismo certificado que el
# plano interno; su SAN lleva las IP privadas (paso 4).
DFSHA_CLIENT_TLS_CERT=/etc/dfsha/certs/control.crt
DFSHA_CLIENT_TLS_KEY=/etc/dfsha/certs/control.key

# --- Replicacion (Etapa 3) -------------------------------------------------
DFSHA_REPLICATION_FACTOR=3
DFSHA_WRITE_QUORUM=2
# Gracia antes de re-replicar un nodo muerto: 5 min por defecto; 30 s para que la
# reposicion se vea en la demostracion. En produccion se deja el default: copiar un disco
# entero por un reinicio de segundos es caro y se encadena.
DFSHA_REREPLICATION_GRACE_MS=30000
DFSHA_PLACEMENT_D=3
DFSHA_MIN_FREE_BYTES=134217728

# --- Pertenencia y liderazgo ------------------------------------------------
DFSHA_HEARTBEAT_INTERVAL_MS=3000
DFSHA_FULL_REPORT_EVERY_N=20
# SUSPECT tiene que ser menor que DEAD, o el servicio no arranca.
DFSHA_SUSPECT_AFTER_MS=10000
DFSHA_DEAD_AFTER_MS=30000
DFSHA_MEMBERSHIP_INTERVAL_MS=1000
# Lease del lider: RENEW menor que TTL, o no arranca. Con estos, el relevo tarda < 10 s.
DFSHA_LEASE_TTL_MS=6000
DFSHA_LEASE_RENEW_MS=2000

# --- No cambian -------------------------------------------------------------
DFSHA_BLOCK_SIZE=67108864
DFSHA_JWT_TTL_SECONDS=3600
DFSHA_WRITE_TTL_SECONDS=600
DFSHA_FILE_LOCK_TTL_MS=120000
DFSHA_LOG_LEVEL=INFO
